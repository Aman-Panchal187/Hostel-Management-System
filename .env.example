# Copy to .env (or run `node infrastructure/docker/gen-env.cjs` to generate one with random secrets).
# NEVER commit the real .env.

NODE_ENV=development

# Express listens here (internal). Nginx is the public entry point.
PORT=3000
NGINX_PORT=8080

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=localpassword
# Used by host tools (prisma CLI, tests, seed). Inside docker compose the backend uses the `postgres` host name.
DATABASE_URL=postgresql://hostel:localpassword@localhost:5433/hostel_management
# Disposable DB for integration tests. The name MUST end with _test (enforced).
TEST_DATABASE_URL=postgresql://hostel:localpassword@localhost:5433/hostel_test

# --- Redis (cache + rate limiting) -----------------------------------------
# Host tools use the published port; compose overrides it with redis://redis:6379.
# Production (Upstash): rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6380

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12
# Production cross-site cookies (Vercel -> Render): COOKIE_SECURE=true, COOKIE_SAMESITE=none (defaults when NODE_ENV=production)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# --- CORS / proxy ----------------------------------------------------------
# Comma separated list of allowed browser origins (exact match, no trailing slash).
FRONTEND_URL=http://localhost:5173
# Number of trusted reverse-proxy hops in front of Express (Nginx = 1).
TRUST_PROXY_HOPS=1

# --- Media -----------------------------------------------------------------
# external   -> users paste HTTPS image/video URLs (local dev, tests; no uploads, no Cloudinary quota)
# cloudinary -> signed uploads (production)
MEDIA_PROVIDER=external
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limits (Redis-backed) --------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SEC=600
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SEC=60
CACHE_TTL_SECONDS=60

# --- Seeding ---------------------------------------------------------------
SEED_PLATFORM_ADMIN_EMAIL=platform.admin@example.test
# Required to create the platform admin. Choose a strong value; there is no default.
SEED_PLATFORM_ADMIN_PASSWORD=
# Demo hostels/users/issues. Development only: never enable on a real production database.
SEED_DEMO_DATA=true
DEMO_PASSWORD=
RUN_SEED_ON_START=true

# --- Frontend (set in Vercel / frontend/.env.production) ---------------------
# Empty in local dev (Vite proxies /api to Nginx). In production: https://<service>.onrender.com
# VITE_API_URL=
