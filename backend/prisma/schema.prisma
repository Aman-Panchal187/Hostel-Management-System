generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  HOSTEL_ADMIN
  ASSISTANT
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  HOSTEL_REGISTRATION
  ASSISTANT_REGISTRATION
  STUDENT_REGISTRATION
}

enum IssueStatus {
  YET_TO_START
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueCategory {
  ELECTRICAL
  PLUMBING
  FURNITURE
  CLEANING
  INTERNET
  WATER_SUPPLY
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AttachmentKind {
  REFERENCE
  RESOLUTION
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String
  role         Role
  status       ApprovalStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  membership       HostelMembership?
  refreshTokens    RefreshToken[]
  reportedIssues   Issue[]              @relation("IssueReporter")
  assignedIssues   Issue[]              @relation("IssueAssignee")
  attachments      IssueAttachment[]
  statusChanges    IssueStatusHistory[]
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]    @relation("ApprovalSubject")
  decidedRequests  ApprovalRequest[]    @relation("ApprovalDecider")

  @@index([role, status])
  @@map("users")
}

model Hostel {
  id           String         @id @default(uuid())
  name         String
  address      String
  city         String
  contactPhone String         @map("contact_phone")
  contactEmail String         @map("contact_email")
  status       ApprovalStatus @default(PENDING)
  isDemo       Boolean        @default(false) @map("is_demo")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  memberships HostelMembership[]
  rooms       Room[]
  issues      Issue[]
  approvals   ApprovalRequest[]
  auditLogs   AuditLog[]

  @@index([status, name])
  @@map("hostels")
}

model HostelMembership {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  hostelId  String   @map("hostel_id")
  role      Role
  roomId    String?  @map("room_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([hostelId, role])
  @@index([roomId])
  @@map("hostel_memberships")
}

model Room {
  id       String @id @default(uuid())
  hostelId String @map("hostel_id")
  number   String
  floor    Int
  capacity Int

  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  memberships HostelMembership[]
  issues      Issue[]

  @@unique([hostelId, number])
  @@map("rooms")
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        ApprovalType
  userId      String         @map("user_id")
  hostelId    String         @map("hostel_id")
  status      ApprovalStatus @default(PENDING)
  decidedById String?        @map("decided_by_id")
  decidedAt   DateTime?      @map("decided_at")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at")

  user      User   @relation("ApprovalSubject", fields: [userId], references: [id], onDelete: Cascade)
  hostel    Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([hostelId, status, createdAt])
  @@index([userId])
  @@map("approval_requests")
}

model Issue {
  id              String        @id @default(uuid())
  hostelId        String        @map("hostel_id")
  roomId          String?       @map("room_id")
  reporterId      String        @map("reporter_id")
  assigneeId      String?       @map("assignee_id")
  title           String
  description     String
  category        IssueCategory
  priority        IssuePriority
  status          IssueStatus   @default(YET_TO_START)
  resolutionNotes String?       @map("resolution_notes")
  version         Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  assignedAt      DateTime?     @map("assigned_at")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  hostel      Hostel               @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room        Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reporter    User                 @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?                @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments IssueAttachment[]
  history     IssueStatusHistory[]

  @@index([hostelId, status, createdAt])
  @@index([hostelId, assigneeId])
  @@index([hostelId, createdAt])
  @@index([reporterId, createdAt])
  @@index([assigneeId, status])
  @@map("issues")
}

model IssueAttachment {
  id              String         @id @default(uuid())
  issueId         String         @map("issue_id")
  uploadedById    String         @map("uploaded_by_id")
  kind            AttachmentKind
  mediaType       MediaType
  url             String
  providerAssetId String?        @map("provider_asset_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([issueId, kind])
  @@map("issue_attachments")
}

model IssueStatusHistory {
  id          String       @id @default(uuid())
  issueId     String       @map("issue_id")
  fromStatus  IssueStatus? @map("from_status")
  toStatus    IssueStatus  @map("to_status")
  changedById String       @map("changed_by_id")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
  @@map("issue_status_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  hostelId   String?  @map("hostel_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  hostel Hostel? @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([hostelId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
